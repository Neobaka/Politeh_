@{
    ViewData["Title"] = "Профориентация";
}

<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Тест на выбор профессии</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #f5f5f5;
        }

        .container_prof {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 60px;
            position: relative;
        }

        .a_link{
            position: absolute;
            right: 25%;
            width: 14%;
        }

        .career-test {
            background: linear-gradient(135deg, #512da8 0%, #03000c 100%);
            color: white;
            padding: 40px 0;
            position: relative;
            overflow: hidden;
            min-height: 300px;
        }

        .breadcrumb {
            display: flex;
            margin-bottom: 20px;
            font-size: 14px;
            opacity: 0.8;
        }

            .breadcrumb a {
                color: white;
                text-decoration: none;
                margin-right: 10px;
            }

            .breadcrumb span:after {
                content: ">";
                margin: 0 10px;
            }

        .career-content {
            width: 60%;
            position: relative;
            z-index: 2;
        }

        h1 {
            font-size: 32px;
            margin-bottom: 20px;
            font-weight: 700;
        }

        .description {
            font-size: 16px;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .author {
            font-size: 14px;
            opacity: 0.7;
            margin-top: 30px;
        }

        .illustrations {
            position: absolute;
            right: 0;
            top: 0;
            height: 100%;
            width: 40%;
            z-index: 1;
        }

        .illustration-item {
            position: absolute;
            animation: float 3s infinite ease-in-out;
        }

        .rocket {
            right: 15%;
            top: 30%;
            width: 100px;
            height: 100px;
        }

        .code {
            right: 5%;
            bottom: 20%;
            width: 60px;
            height: 60px;
        }

        .book {
            left: 10%;
            top: 15%;
            width: 50px;
            height: 50px;
        }

        .star {
            right: 35%;
            top: 15%;
            width: 15px;
            height: 15px;
            background-color: white;
            border-radius: 50%;
            opacity: 0.7;
        }

        .fist {
            right: 30%;
            top: 50%;
            width: 70px;
            height: 70px;
        }

        .test-person {
            right: 10%;
            bottom: 10%;
            width: 80px;
            height: 120px;
        }

        .purchase-btn {
            position: absolute;
            right: 30px;
            bottom: 30px;
            background-color: #ff5722;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 30px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(255, 87, 34, 0.4);
            transition: all 0.3s ease;
            z-index: 10;
        }

            .purchase-btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 6px 15px rgba(255, 87, 34, 0.5);
            }

        .social-share {
            position: absolute;
            right: 30px;
            top: 30px;
            z-index: 10;
        }

        .share-icon {
            width: 30px;
            height: 30px;
            background-color: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        @@keyframes float {
            0%

        {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-10px);
        }

        100% {
            transform: translateY(0px);
        }

        }

        @@media (max-width: 768px) {
            .career-content

        {
            width: 100%;
        }

        .illustrations {
            opacity: 0.2;
            width: 100%;
        }

        }
    </style>
</head>

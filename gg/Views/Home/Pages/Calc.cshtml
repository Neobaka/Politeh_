                            <div class="specialty-item" onclick="selectSpecialty(this, '12.03.04', 'Биотехнические системы и технологии')">
                                <div class="specialty-info">
                                    <div class="specialty-code">12.03.04</div>
                                    <div class="specialty-name">Биотехнические системы и технологии</div>
                                </div>
                                <span class="specialty-level">Б</span>
                            </div>
                        </div>
                        <div class="no-results" id="noResults" style="display: none;">
                            Ничего не найдено. Попробуйте изменить запрос.
                        </div>
                    </div>
                </div>
            </div>

            <div class="subjects-grid">
                <div class="subject-card" onclick="toggleSubject(this, 'russian')">
                    <div class="subject-icon">📝</div>
                    <div class="subject-name">Русский язык</div>
                    <div class="subject-range">от 36 до 100</div>
                    <input type="number" class="score-input" placeholder="Балл" min="36" max="100" style="display: none;">
                </div>

                <div class="subject-card" onclick="toggleSubject(this, 'math')">
                    <div class="subject-icon">🔢</div>
                    <div class="subject-name">Математика</div>
                    <div class="subject-range">от 27 до 100</div>
                    <input type="number" class="score-input" placeholder="Балл" min="27" max="100" style="display: none;">
                </div>

                <div class="subject-card" onclick="toggleSubject(this, 'social')">
                    <div class="subject-icon">🏛️</div>
                    <div class="subject-name">Обществознание</div>
                    <div class="subject-range">от 42 до 100</div>
                    <input type="number" class="score-input" placeholder="Балл" min="42" max="100" style="display: none;">
                </div>

                <div class="subject-card" onclick="toggleSubject(this, 'foreign')">
                    <div class="subject-icon">🌍</div>
                    <div class="subject-name">Иностранный язык</div>
                    <div class="subject-range">от 22 до 100</div>
                    <input type="number" class="score-input" placeholder="Балл" min="22" max="100" style="display: none;">
                </div>

                <div class="subject-card" onclick="toggleSubject(this, 'ict')">
                    <div class="subject-icon">💻</div>
                    <div class="subject-name">ИКТ</div>
                    <div class="subject-range">от 40 до 100</div>
                    <input type="number" class="score-input" placeholder="Балл" min="40" max="100" style="display: none;">
                </div>

                <div class="subject-card" onclick="toggleSubject(this, 'biology')">
                    <div class="subject-icon">🧬</div>
                    <div class="subject-name">Биология</div>
                    <div class="subject-range">от 36 до 100</div>
                    <input type="number" class="score-input" placeholder="Балл" min="36" max="100" style="display: none;">
                </div>

                <div class="subject-card" onclick="toggleSubject(this, 'geography')">
                    <div class="subject-icon">🌍</div>
                    <div class="subject-name">География</div>
                    <div class="subject-range">от 37 до 100</div>
                    <input type="number" class="score-input" placeholder="Балл" min="37" max="100" style="display: none;">
                </div>

                <div class="subject-card" onclick="toggleSubject(this, 'chemistry')">
                    <div class="subject-icon">⚗️</div>
                    <div class="subject-name">Химия</div>
                    <div class="subject-range">от 36 до 100</div>
                    <input type="number" class="score-input" placeholder="Балл" min="36" max="100" style="display: none;">
                </div>

                <div class="subject-card" onclick="toggleSubject(this, 'physics')">
                    <div class="subject-icon">⚛️</div>
                    <div class="subject-name">Физика</div>
                    <div class="subject-range">от 36 до 100</div>
                    <input type="number" class="score-input" placeholder="Балл" min="36" max="100" style="display: none;">
                </div>

                <div class="subject-card" onclick="toggleSubject(this, 'literature')">
                    <div class="subject-icon">📚</div>
                    <div class="subject-name">Литература</div>
                    <div class="subject-range">от 32 до 100</div>
                    <input type="number" class="score-input" placeholder="Балл" min="32" max="100" style="display: none;">
                </div>

                <div class="subject-card" onclick="toggleSubject(this, 'history')">
                    <div class="subject-icon">🏛️</div>
                    <div class="subject-name">История</div>
                    <div class="subject-range">от 32 до 100</div>
                    <input type="number" class="score-input" placeholder="Балл" min="32" max="100" style="display: none;">
                </div>

                <div class="subject-card" onclick="toggleSubject(this, 'additional')">
                    <div class="subject-icon">➕</div>
                    <div class="subject-name">Доп. экзамен</div>
                    <div class="subject-range"></div>
                    <input type="number" class="score-input" placeholder="Балл" min="0" max="100" style="display: none;">
                </div>
            </div>

            <div class="total-score" id="totalScore" style="display: none;">
                <h3>Общий балл</h3>
                <div class="score" id="scoreValue">0</div>
            </div>

            <div class="dropdown">
                <div class="dropdown-header">
                    <span>Вся Россия</span>
                    <span>▼</span>
                </div>
            </div>

            <div class="section-title">Укажите индивидуальные достижения</div>
            <div class="achievements">
                <div class="achievement-toggle" onclick="toggleAchievement(this)">
                    <span>Медаль</span>
                    <div class="toggle-switch"></div>
                </div>
                <div class="achievement-toggle" onclick="toggleAchievement(this)">
                    <span>ГТО</span>
                    <div class="toggle-switch"></div>
                </div>
                <div class="achievement-toggle" onclick="toggleAchievement(this)">
                    <span>Волонтерство</span>
                    <div class="toggle-switch"></div>
                </div>
            </div>

            <div class="section-title">Укажите формы обучения</div>
            <div class="study-forms">
                <div class="form-toggle active" onclick="toggleForm(this)">Очная</div>
                <div class="form-toggle" onclick="toggleForm(this)">Заочная</div>
                <div class="form-toggle" onclick="toggleForm(this)">Очно-заочная</div>
            </div>

            <select class="region-dropdown">
                <option>Без группировки</option>
                <option>По регионам</option>
                <option>По федеральным округам</option>
            </select>

            <button class="search-button" onclick="search()">Искать</button>
        </div>

        <script>
            let selectedSubjects = new Set();
            let scores = {};
            let selectedSpecialtyData = { code: 'any', name: 'Любое направление подготовки' };

            function openSpecialtyModal() {
                const modal = document.getElementById('specialtyModal');
                modal.classList.add('show');
                document.body.style.overflow = 'hidden';

                // Сброс поиска
                document.getElementById('specialtySearch').value = '';
                filterSpecialties('');
            }

            function closeSpecialtyModal() {
                const modal = document.getElementById('specialtyModal');
                modal.classList.remove('show');
                document.body.style.overflow = 'auto';
            }

            function selectSpecialty(element, code, name) {
                // Убираем выделение с предыдущего элемента
                document.querySelectorAll('.specialty-item').forEach(item => {
                    item.classList.remove('selected');
                });

                // Выделяем выбранный элемент
                element.classList.add('selected');

                // Сохраняем выбранную специальность
                selectedSpecialtyData = { code, name };

                // Обновляем отображение в dropdown
                document.getElementById('selectedSpecialty').textContent = name;

                // Закрываем модальное окно
                setTimeout(() => {
                    closeSpecialtyModal();
                }, 300);
            }

            function filterSpecialties(searchTerm) {
                const specialties = document.querySelectorAll('.specialty-item');
                const noResults = document.getElementById('noResults');
                let visibleCount = 0;

                specialties.forEach(specialty => {
                    const nameElement = specialty.querySelector('.specialty-name');
                    const codeElement = specialty.querySelector('.specialty-code');

                    if (nameElement) {
                        const name = nameElement.textContent.toLowerCase();
                        const code = codeElement ? codeElement.textContent.toLowerCase() : '';
                        const search = searchTerm.toLowerCase();

                        if (name.includes(search) || code.includes(search)) {
                            specialty.style.display = 'flex';
                            visibleCount++;
                        } else {
                            specialty.style.display = 'none';
                        }
                    }
                });

                // Показываем/скрываем сообщение "Ничего не найдено"
                if (visibleCount === 0 && searchTerm.length > 0) {
                    noResults.style.display = 'block';
                } else {
                    noResults.style.display = 'none';
                }
            }

            // Обработчик поиска
            document.addEventListener('DOMContentLoaded', function() {
                const searchInput = document.getElementById('specialtySearch');
                if (searchInput) {
                    searchInput.addEventListener('input', function() {
                        filterSpecialties(this.value);
                    });
                }

                // Закрытие модального окна при клике вне его
                const modal = document.getElementById('specialtyModal');
                modal.addEventListener('click', function(e) {
                    if (e.target === modal) {
                        closeSpecialtyModal();
                    }
                });

                // Закрытие модального окна по Escape
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape' && modal.classList.contains('show')) {
                        closeSpecialtyModal();
                    }
                });
            });

            function toggleSubject(element, subject) {
                const input = element.querySelector('.score-input');

                if (element.classList.contains('selected')) {
                    element.classList.remove('selected');
                    input.style.display = 'none';
                    selectedSubjects.delete(subject);
                    delete scores[subject];
                } else {
                    element.classList.add('selected');
                    input.style.display = 'block';
                    selectedSubjects.add(subject);
                    input.focus();
                }

                input.addEventListener('input', function() {
                    scores[subject] = parseInt(this.value) || 0;
                    updateTotalScore();
                });

                updateTotalScore();
            }

            function updateTotalScore() {
                const total = Object.values(scores).reduce((sum, score) => sum + score, 0);
                const totalScoreElement = document.getElementById('totalScore');
                const scoreValueElement = document.getElementById('scoreValue');

                if (total > 0) {
                    totalScoreElement.style.display = 'block';
                    scoreValueElement.textContent = total;
                } else {
                    totalScoreElement.style.display = 'none';
                }
            }

            function toggleAchievement(element) {
                element.classList.toggle('active');
            }

            function toggleForm(element) {
                document.querySelectorAll('.form-toggle').forEach(toggle => {
                    toggle.classList.remove('active');
                });
                element.classList.add('active');
            }

            function search() {
                const selectedSubjectsArray = Array.from(selectedSubjects);
                const totalScore = Object.values(scores).reduce((sum, score) => sum + score, 0);

                if (selectedSubjectsArray.length === 0) {
                    alert('Выберите хотя бы один предмет');
                    return;
                }

                console.log('Поиск с параметрами:');
                console.log('Выбранная специальность:', selectedSpecialtyData);
                console.log('Выбранные предметы:', selectedSubjectsArray);
                console.log('Баллы:', scores);
                console.log('Общий балл:', totalScore);

                // Здесь можно добавить логику отправки данных на сервер
                alert(`Поиск выполнен!\nСпециальность: ${selectedSpecialtyData.name}\nОбщий балл: ${totalScore}`);
            }

            // Добавляем анимацию при загрузке
            document.addEventListener('DOMContentLoaded', function() {
                const cards = document.querySelectorAll('.subject-card');
                cards.forEach((card, index) => {
                    card.style.opacity = '0';
                    card.style.transform = 'translateY(20px)';
                    setTimeout(() => {
                        card.style.transition = 'all 0.5s ease';
                        card.style.opacity = '1';
                        card.style.transform = 'translateY(0)';
                    }, index * 100);
                });
            });
        </script>
    </body>
</html>
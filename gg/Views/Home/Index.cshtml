@{
    ViewData["Title"] = "Главная";
}




<body>
    <main>
        <div>
            <header>
                <div>
                    <nav class="navigation">
                            <ul>
                            <li><a asp-controller="Home" asp-action="Index" class="nav-button-main">Главная</a></li>
                            <li><a href="" class="nav-button-main">Рейтинг по отзывам</a></li>
                            <li><a asp-controller="Home" asp-action="RAEX" class="nav-button-main">Рейтинг по REAX</a></li>
                            <li><a asp-controller="Home" asp-action="Prof" class="nav-button-main">Профориентация</a></li>
                            <li><a href="" class="nav-button-main">Вебинары</a></li>
                            <li><a asp-controller="Home" asp-action="Calc" class="nav-button-main">Калькулятор ЕГЭ</a></li>
                            <li><a href="" class="nav-button-main">Сравнение ВУЗов</a></li>
                            <li><a asp-controller="Home" asp-action="Guide" class="nav-button-main">Гайды</a></li>
                            <li><a asp-controller="Home" asp-action="Open_doors" class="nav-button-main">Дни открытых дверей</a></li>
                            <li><a asp-controller="Home" asp-action="Kabinet" class="nav-button-main">Личный кабинет</a></li>
                            <li><a asp-controller="Home" asp-action="Index_rabota" class="nav-button-main">Личный кабинет</a></li>
                            </ul>
                    </nav>
                </div>
            </header>
        </div>

        <div class="Content">
            <section>
                <div>
                    <div class="Kuda_top">
                        <h3>
                            <p class="Kuda_top_text">
                                <span>
                                    КудаПоступим.ру
                                </span>
                            </p>
                        </h3>
                    </div>
                    <div class="Kuda_bott">
                        <div>
                            <p class="Kuda_bott_upper_text">
                                <span>
                                    Выберите университет своей мечты по отзывам от реальных студентов!
                                </span>
                            </p>
                        </div>
                        <div>
                            <a class="Kuda_bott_lower_text">
                                КудаПоступим.ру — идеальное средство для студентов, которые стремятся найти лучшую образовательную программу, соответствующую их амбициям и потребностям
                            </a>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="bottom_section">
            <section>
                <div>
                    <p class="bottom_section_text">
                        КудаПоступим.ру - твой помощник в выборе университета мечты! Сравнивай,
                    <span style="color: rgb(0, 32, 81);">анализируй</span>
                        , принимай решение.
                    </p>
                </div>
            </section>
        </div>

        <div class="lower_content">
            <div class="bott_blocks">
                <div class="filterDiv obshaga trud hard voen useful dop">
                    <a asp-controller="Home" asp-action="SPB_vuz">
                        <div class="university-card">
                            <div class="university-image">
                                <img src="https://avatars.mds.yandex.net/get-altay/11368589/2a0000018bc765d3bab1020f3b660eb59b2e/XXL_height" alt="Политех">
                                <div class="tuition-fee">от 44 000 ₽/семестр</div>
                            </div>
                            <div class="university-info">
                                <div class="location">Санкт-Петербург</div>
                                <div class="university-name">Санкт-Петербургский политехнический университет Петра Великого</div>
                                <div class="university-rating">№8 в рейтинге RAEX</div>
                                <button class="reviews-button">Отзывы</button>
                                <div class="scores">
                                    <div class="score">от <span>54</span> бал. бюджет</div>
                                    <div class="score">от <span>51</span> бал. платно</div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="filterDiv trud hard useful staz fun dost">
                    <a asp-controller="Home" asp-action="ITMO_vuz">
                        <div class="university-card">
                            <div class="university-image">
                                <img src="https://smapse.ru/storage/2020/10/itmo-spb-smapse2.jpg" alt="Итмо">
                                <div class="tuition-fee">от 44 000 ₽/семестр</div>
                            </div>
                            <div class="university-info">
                                <div class="location">Санкт-Петербург</div>
                                <div class="university-name">Университет ИТМО</div>
                                <div class="university-rating">№14 в рейтинге по RAEX</div>
                                <button class="reviews-button">Отзывы</button>
                                <div class="scores">
                                    <div class="score">от <span>74</span> бал. бюджет</div>
                                    <div class="score">от <span>65</span> бал. платно</div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="filterDiv obshaga useful staz prepod fun dop dost vremya">
                    <div class="university-card">
                        <div class="university-image">
                            <img src="https://obruchev.mos.ru/%D1%80%D1%83%D0%B4%D0%BD89%D0%B7%D1%88%D1%89%D0%B6%D0%BB%D0%B4.jpg" alt="Итмо">
                            <div class="tuition-fee">от 44 000 ₽/семестр</div>
                        </div>
                        <div class="university-info">
                            <div class="location">Москва</div>
                            <div class="university-name">Российский университет дружбы народов</div>
                            <div class="university-rating">№19 в рейтинге по RAEX</div>
                            <button class="reviews-button">Отзывы</button>
                            <div class="scores">
                                <div class="score">от <span>61</span> бал. бюджет</div>
                                <div class="score">от <span>33</span> бал. платно</div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="filterDiv obshaga trud hard voen useful staz prepod fun dop">
                    <div class="university-card">
                        <div class="university-image">
                            <img src="https://dpru.obs.ru-moscow-1.hc.sbercloud.ru/images/article/2020/08/21/96AEB8FB-D105-4D93-97CA-15D7BE05E0B8.jpg" alt="Итмо">
                            <div class="tuition-fee">от 44 000 ₽/семестр</div>
                        </div>
                        <div class="university-info">
                            <div class="location">Санкт-Петербург</div>
                            <div class="university-name">Санкт-Петербургский государственный уневиреситет</div>
                            <div class="university-rating">№3 в рейтинге по RAEX</div>
                            <button class="reviews-button">Отзывы</button>
                            <div class="scores">
                                <div class="score">от <span>85</span> бал. бюджет</div>
                                <div class="score">от <span>51</span> бал. платно</div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            <div id="myBtnContainer" >
                <h2 class="header">Параметры выбора</h2>
                <button class="btn active" data-filter="all" onclick="filterSelection('all')">Показать все</button>
                <button class="btn" data-filter="obshaga" onclick="filterSelection('obshaga')"> Общежитие</button>
                <button class="btn" data-filter="trud" onclick="filterSelection('trud')"> Привлекательность при трудоустройстве</button>
                <button class="btn" data-filter="hard" onclick="filterSelection('hard')"> Сложность обучения</button>
                <button class="btn" data-filter="voen" onclick="filterSelection('voen')"> Военная кафедра</button>
                <button class="btn" data-filter="useful" onclick="filterSelection('useful')"> Полезность предметов для дальнейшей жизни</button>
                <button class="btn" data-filter="staz" onclick="filterSelection('staz')"> Стажировка</button>
                <button class="btn" data-filter="prepod" onclick="filterSelection('prepod')"> Преподавательский состав</button>
                <button class="btn" data-filter="fun" onclick="filterSelection('fun')"> Развлечения</button>
                <button class="btn" data-filter="dop" onclick="filterSelection('dop')"> Доп. образование\курсы</button>
                <button class="btn" data-filter="dost" onclick="filterSelection('dost')"> Транспортная доступность</button>
                <button class="btn" data-filter="vremya" onclick="filterSelection('vremya')"> Наличие пространства для свободного времяпрепровождения</button>
                <button class="btn" data-filter="eat" onclick="filterSelection('eat')"> Столовая</button>
                <button class="btn" data-filter="udobno" onclick="filterSelection('udobno')"> Удобность ссайта ВУЗа</button>
                <button class="btn" data-filter="security" onclick="filterSelection('security')"> Безопастность</button>
                <button class="btn" data-filter="lifehacks" onclick="filterSelection('lifehacks')"> Фишки ВУЗа</button>
            </div>

        </div>
    </main>
                

    <div class="footer">
        <section>
                <div class="row">
                    <div class="contacts">
                        <h2>
                            НАШИ КОНТАКТЫ
                        </h2>
                            <address>
                                <span>
                                    Для прессы:
                                </span>
                                <a href="#">
                                    kudapostupim_press
                                </a>
                            </address>
                    </div>
                    <div class="info">
                        <h2>
                            ИНФОРМАЦИЯ
                        </h2>
                        <ul class="info-ul">
                            <li>
                                <a href="#">О САЙТЕ</a>
                            </li>
                            <li>
                                <a href="#">ВУЗАМ</a>
                            </li>
                            <li>
                                <a href="#">ЦЕЛЕВОЙ АУДИТОРИИ</a>
                            </li>
                            <li>
                                <a href="#">РЕКЛАМОДАТЕЛЯМ</a>
                            </li>
                        </ul>

                    </div>
                    <div clas="activity">
                        <h2>АКТИВНОСТИ</h2>
                        <ul class="activity-ul">
                            <li><a href="#">РЕЙТИНГ ПО ОТЗЫВАМ</a></li>
                            <li><a href="#">РЕЙТИНГ RAEX</a></li>
                            <li><a href="#">КАЛЬКУЛЯТОР ЕГЭ</a></li>
                            <li><a href="#">ПРОФОРИЕНТАЦИЯ</a></li>
                            <li><a href="#">ВЕБИНАРЫ</a></li>
                            <li><a href="#">ГАЙДЫ</a></li>
                            <li><a href="#">ДНИ ОТКРЫТЫХ ДВЕРЕЙ</a></li>
                        </ul>
                    </div>
                    <div class="more">
                        <h2>ДОПОЛНИТЕЛЬНО</h2>
                        <ul class="more-ul">
                            <li><a href="#">ДОБАВИТЬ ВУЗ</a></li>
                            <li><a href="#">НАШИ ПАРТНЁРЫ</a></li>
                            <li><a href="#">ОБРАТНАЯ СВЯЗЬ</a></li>
                            <li><a href="#">ЛИЧНЫЙ КАБИНЕТ</a></li>
                            <li><a href="#">УДАЛИТЬ АККАУНТ</a></li>
                        </ul>
                    </div>

                </div>
            
        </section>
        <!-- Кнопка обратной связи -->
        <button class="feedback-button" id="feedbackBtn">
            <svg class="feedback-icon" viewBox="0 0 24 24">
                <path d="M20 2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z" />
            </svg>
        </button>

        <div class="modal" id="feedbackModal">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title">Обратная связь</h2>
                    <button class="close-button" id="closeModal">&times;</button>
                </div>
                <form class="feedback-form" id="feedbackForm">
                    <div class="form-group">
                        <label for="name">Ваше имя</label>
                        <input type="text" id="name" name="name" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    <div class="form-group">
                        <label for="message">Сообщение</label>
                        <textarea id="message" name="message" required></textarea>
                    </div>
                    <button type="submit" class="submit-button">Отправить</button>
                </form>
            </div>
        </div>

        <script src="script.js"></script>

        <div>
            <p>
                © 2023, KUDAPOSTUPIM.RU
            </p>
        </div>
    </div>


    <script>
        
    </script>
</body>

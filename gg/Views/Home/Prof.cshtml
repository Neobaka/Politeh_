                <div class="illustration-item star" style="right: 15%; bottom: 30%; width: 12px; height: 12px;"></div>
            </div>

            <a asp-controller="Home" asp-action="Result" class="a_link"><button class="purchase-btn">Купить за 199₽</button></a>
            

            <div class="social-share">

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Результат теста</title>
    <style>
        body {
            background-color: #6c5ce7;
            font-family: Arial, sans-serif;
            color: white;
            text-align: center;
            padding: 40px 0px 0px 0px;
            width: 95%;
            background: linear-gradient(135deg, #512da8 0%, #03000c 100%);
        }

        .result-page {
            text-align: center;
            padding: 40px 20px;
        }

        .result-title {
            font-size: 28px;
            margin-bottom: 30px;
            color: black;
        }

        .profession-image {
            width: 200px;
            height: 200px;
            margin: 0 auto 30px;
            background-color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

            .profession-image img {
                max-width: 90%;
                max-height: 90%;
            }

        .result-buttons {
            display: flex;
            flex-direction: column;
            gap: 15px;
            max-width: 400px;
            margin: 0 auto;
        }

        .result-btn {
            background-color: #2ecc71;
            color: white;
            border: none;
            padding: 12px 20px;
            font-size: 16px;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

            .result-btn:hover {
                background-color: #27ae60;
            }

            .result-btn.secondary {
                background-color: #3498db;
            }

                .result-btn.secondary:hover {
                    background-color: #2980b9;
                }

        /* Адаптивный дизайн */
        @@media (max-width: 768px) {
            .container_prof

        {
            padding: 15px;
        }

        h1 {
            font-size: 26px;
        }

        .description p {
            font-size: 16px;
        }

        .result-buttons {
            max-width: 100%;
        }

        }
    </style>
</head>


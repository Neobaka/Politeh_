@{
    ViewData["Title"] = "Калькулятор Егэ";
}

<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Тест на выбор профессии</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #512da8 0%, #03000c 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: #2c3e50;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
        }

            .header h1 {
                color: white;
                font-size: 2.5rem;
                font-weight: 700;
                margin-bottom: 10px;
            }

            .header p {
                color: #bdc3c7;
                font-size: 1.1rem;
            }

        .stats {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .stat-item {
            text-align: center;
            color: white;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: bold;
            color: #3498db;
        }

        .stat-label {
            font-size: 0.9rem;
            color: #bdc3c7;
            margin-top: 5px;
        }

        .dropdown {
            margin-bottom: 30px;
        }

        .dropdown-header {
            background: #34495e;
            color: white;
            padding: 15px 20px;
            border-radius: 10px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
        }

            .dropdown-header:hover {
                background: #4a6741;
                transform: translateY(-2px);
            }

        .subjects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 30px;
        }

        .subject-card {
            background: #34495e;
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            transition: all 0.3s ease;
            cursor: pointer;
            border: 2px solid transparent;
            position: relative;
            overflow: hidden;
        }

            .subject-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
                transition: left 0.5s;
            }

            .subject-card:hover::before {
                left: 100%;
            }

            .subject-card:hover {
                transform: translateY(-5px);
                border-color: #3498db;
                box-shadow: 0 10px 20px rgba(52, 152, 219, 0.3);
            }

            .subject-card.selected {
                background: #3498db;
                border-color: #2980b9;
            }

        .subject-icon {
            width: 40px;
            height: 40px;
            margin: 0 auto 10px;
            background: #3498db;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .subject-card.selected .subject-icon {
            background: white;
            color: #3498db;
        }

        .subject-name {
            color: white;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .subject-range {
            color: #bdc3c7;
            font-size: 0.9rem;
        }

        .score-input {
            width: 100%;
            padding: 10px;
            border: none;
            border-radius: 8px;
            background: #2c3e50;
            color: white;
            text-align: center;
            margin-top: 10px;
            font-size: 1.1rem;
        }

            .score-input:focus {
                outline: 2px solid #3498db;
            }

        .section-title {
            color: white;
            font-size: 1.3rem;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .achievements {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .achievement-toggle {
            background: #34495e;
            color: white;
            padding: 12px 20px;
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid transparent;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .achievement-toggle:hover {
                transform: translateY(-2px);
                border-color: #3498db;
            }

            .achievement-toggle.active {
                background: #3498db;
                border-color: #2980b9;
            }

        .toggle-switch {
            width: 40px;
            height: 20px;
            background: #7f8c8d;
            border-radius: 10px;
            position: relative;
            transition: all 0.3s ease;
        }

            .toggle-switch::after {
                content: '';
                position: absolute;
                width: 16px;
                height: 16px;
                background: white;
                border-radius: 50%;
                top: 2px;
                left: 2px;
                transition: all 0.3s ease;
            }

        .achievement-toggle.active .toggle-switch {
            background: #27ae60;
        }

            .achievement-toggle.active .toggle-switch::after {
                transform: translateX(20px);
            }

        .study-forms {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .form-toggle {
            background: #34495e;
            color: white;
            padding: 12px 20px;
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid transparent;
            position: relative;
        }

            .form-toggle:hover {
                transform: translateY(-2px);
                border-color: #3498db;
            }

            .form-toggle.active {
                background: #3498db;
                border-color: #2980b9;
            }

        .region-dropdown {
            background: #34495e;
            color: white;
            padding: 15px 20px;
            border-radius: 10px;
            border: none;
            width: 300px;
            font-size: 1rem;
            cursor: pointer;
            margin-bottom: 30px;
        }

        .search-button {
            width: 100%;
            background: linear-gradient(135deg, #3498db, #2980b9);
            color: white;
            padding: 20px;
            border: none;
            border-radius: 15px;
            font-size: 1.2rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

            .search-button:hover {
                transform: translateY(-3px);
                box-shadow: 0 15px 30px rgba(52, 152, 219, 0.4);
            }

            .search-button:active {
                transform: translateY(0);
            }

        /* Модальное окно */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.7);
            backdrop-filter: blur(5px);
            animation: fadeIn 0.3s ease;
        }

            .modal.show {
                display: flex;
                align-items: center;
                justify-content: center;
            }

        .modal-content {
            background: #2c3e50;
            border-radius: 20px;
            padding: 0;
            width: 90%;
            max-width: 800px;
            max-height: 80vh;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
            animation: modalSlideIn 0.3s ease;
        }

        .modal-header {
            padding: 25px 30px;
            background: #34495e;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #4a5568;
        }

        .modal-title {
            color: white;
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
        }

        .close-button {
            background: none;
            border: none;
            color: #bdc3c7;
            font-size: 2rem;
            cursor: pointer;
            padding: 0;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: all 0.3s ease;
        }

            .close-button:hover {
                background: #e74c3c;
                color: white;
                transform: rotate(90deg);
            }

        .modal-body {
            padding: 25px 30px;
            max-height: 60vh;
            overflow-y: auto;
        }

        .search-container {
            position: relative;
            margin-bottom: 20px;
        }

        .search-input {
            width: 100%;
            padding: 15px 50px 15px 20px;
            border: 2px solid #4a5568;
            border-radius: 10px;
            background: #34495e;
            color: white;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .search-input:focus {
                outline: none;
                border-color: #3498db;
                box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
            }

            .search-input::placeholder {
                color: #95a5a6;
            }

        .search-icon {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #95a5a6;
            font-size: 1.2rem;
        }

        .specialties-list {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .specialty-item {
            padding: 15px 20px;
            background: #34495e;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2px;
        }

            .specialty-item:hover {
                background: #4a6741;
                transform: translateX(5px);
            }

            .specialty-item.selected {
                background: #3498db;
                color: white;
            }

        .specialty-info {
            flex: 1;
        }

        .specialty-code {
            color: #95a5a6;
            font-size: 0.9rem;
            margin-bottom: 3px;
        }

        .specialty-item.selected .specialty-code {
            color: rgba(255,255,255,0.8);
        }

        .specialty-name {
            color: white;
            font-weight: 500;
            line-height: 1.3;
        }

        .specialty-level {
            color: #95a5a6;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 4px 8px;
            background: rgba(149, 165, 166, 0.2);
            border-radius: 12px;
            margin-left: 15px;
        }

        .specialty-item.selected .specialty-level {
            background: rgba(255,255,255,0.2);
            color: white;
        }

        .no-results {
            text-align: center;
            padding: 40px 20px;
            color: #95a5a6;
            font-size: 1.1rem;
        }

        @@keyframes fadeIn {
            from

        {
            opacity: 0;
        }

        to {
            opacity: 1;
        }

        }

        @@keyframes modalSlideIn {
            from

        {
            opacity: 0;
            transform: translateY(-50px) scale(0.9);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        }

        @@media (max-width: 768px) {
            .container

        {
            padding: 20px;
        }

        .header h1 {
            font-size: 2rem;
        }

        .subjects-grid {
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 10px;
        }

        .stats {
            gap: 15px;
        }

        .achievements, .study-forms {
            flex-direction: column;
        }

        .region-dropdown {
            width: 100%;
        }

        .modal-content {
            width: 95%;
            max-height: 90vh;
        }

        .modal-header, .modal-body {
            padding: 20px;
        }

        .modal-title {
            font-size: 1.3rem;
        }

        }

        .total-score {
            background: linear-gradient(135deg, #27ae60, #2ecc71);
            padding: 20px;
            border-radius: 15px;
            text-align: center;
            margin-bottom: 20px;
            color: white;
        }

            .total-score h3 {
                font-size: 1.5rem;
                margin-bottom: 10px;
            }

            .total-score .score {
                font-size: 3rem;
                font-weight: bold;
            }
    </style>
</head>

@{
    ViewData["Title"] = "День открытых дверей";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Дни открытых дверей</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #512da8 0%, #03000c 100%);
            min-height: 100vh;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            background-color: unset;
            display: grid;
        }

        .header {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 30px;
            text-align: center;
            color: white;
        }

            .header h1 {
                font-size: 2.5rem;
                margin-bottom: 15px;
                font-weight: 700;
            }

            .header p {
                font-size: 1.1rem;
                opacity: 0.9;
                line-height: 1.6;
            }

        .stats {
            display: flex;
            justify-content: center;
            gap: 60px;
            margin: 25px 0;
        }

        .stat-item {
            text-align: center;
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: 800;
            color: #4FC3F7;
            display: block;
        }

        .stat-label {
            font-size: 0.9rem;
            opacity: 0.8;
        }

        .filters {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .filter-section {
            margin-bottom: 20px;
        }

        .filter-title {
            font-weight: 600;
            margin-bottom: 15px;
            color: #333;
            font-size: 1.1rem;
        }

        .filter-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .filter-btn {
            background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
            border: none;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            color: #1976D2;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 500;
        }

            .filter-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(25, 118, 210, 0.3);
            }

            .filter-btn.active {
                background: linear-gradient(135deg, #7C4DFF, #651FFF);
                color: white;
            }

        .month-navigation {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .month-btn {
            background: rgba(255, 255, 255, 0.9);
            border: none;
            padding: 12px 24px;
            border-radius: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            color: #666;
        }

            .month-btn.active {
                background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
                color: white;
            }

            .month-btn:hover:not(.active) {
                background: rgba(255, 255, 255, 1);
                transform: translateY(-2px);
            }

        .events-section {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 25px;
            color: #333;
        }

        .event-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            border-left: 4px solid transparent;
        }

            .event-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
            }

            .event-card.online {
                border-left-color: #4FC3F7;
            }

            .event-card.offline {
                border-left-color: #66BB6A;
            }

        .event-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 15px;
        }

        .event-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .event-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 1.2rem;
        }

        .event-details h3 {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 5px;
            color: #333;
        }

        .event-university {
            color: #4FC3F7;
            font-weight: 600;
            margin-bottom: 3px;
        }

        .event-datetime {
            color: #666;
            font-size: 0.9rem;
        }

        .event-actions {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

        .btn-primary {
            background: linear-gradient(135deg, #00BCD4, #00ACC1);
            color: white;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0, 188, 212, 0.4);
            }

        .btn-secondary {
            background: #f5f5f5;
            color: #666;
        }

            .btn-secondary:hover {
                background: #eee;
            }

        .remind-btn {
            color: #00BCD4;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
        }

            .remind-btn:hover {
                text-decoration: underline;
            }

        .event-format {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: 600;
            margin-top: 10px;
        }

        .format-online {
            background: rgba(79, 195, 247, 0.2);
            color: #0277BD;
        }

        .format-offline {
            background: rgba(102, 187, 106, 0.2);
            color: #2E7D32;
        }

        @@media (max-width: 768px) {
            .stats

        {
            gap: 30px;
        }

        .stat-number {
            font-size: 2rem;
        }

        .filter-buttons {
            justify-content: center;
        }

        .month-navigation {
            flex-wrap: wrap;
        }

        .event-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .event-actions {
            width: 100%;
            justify-content: space-between;
        }

        }
    </style>
</head>
<body>

    <nav class="nav-bar">
        <ul>
            <li><a asp-controller="Home" asp-action="Index" class="nav-item">Главная</a></li>
            <li><a href="" class="nav-item">Рейтинг по отзывам</a></li>
            <li><a asp-controller="Home" asp-action="RAEX" class="nav-item">Рейтинг по REAX</a></li>
            <li><a asp-controller="Home" asp-action="Prof" class="nav-item">Профориентация</a></li>
            <li><a href="" class="nav-item">Вебинары</a></li>
            <li><a asp-controller="Home" asp-action="Calc" class="nav-item">Калькулятор ЕГЭ</a></li>
            <li><a href="" class="nav-item">Сравнение ВУЗов</a></li>
            <li><a asp-controller="Home" asp-action="Guide" class="nav-item">Гайды</a></li>
            <li><a asp-controller="Home" asp-action="Open_doors" class="nav-item">Дни открытых дверей</a></li>
            <li><a asp-controller="Home" asp-action="Kabinet" class="nav-item">Личный кабинет</a></li>
            <li><a asp-controller="Home" asp-action="Index_rabota" class="nav-item">Личный кабинет</a></li>
        </ul>
    </nav>
    <div class="container">
        <div class="header">
            <h1>Дни открытых дверей</h1>
            <p>Познакомьтесь с лучшими университетами и образовательными программами</p>
            <div class="stats">
                <div class="stat-item">
                    <span class="stat-number">150+</span>
                    <span class="stat-label">университетов</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number">300+</span>
                    <span class="stat-label">мероприятий</span>
                </div>
            </div>
        </div>

        <div class="month-navigation">
            <button class="month-btn">Все</button>
            <button class="month-btn">Май 2025</button>
            <button class="month-btn">Июнь 2025</button>
            <button class="month-btn">Июль 2025</button>
            <button class="month-btn active">Август 2025</button>
            <button class="month-btn">Сентябрь 2025</button>
        </div>

        <div class="filters">
            <div class="filter-section">
                <div class="filter-title">Все по датам для абитуриентов:</div>
                <div class="filter-buttons">
                    <button class="filter-btn">Куда еще можно</button>
                    <button class="filter-btn">Витрина вузов</button>
                    <button class="filter-btn">Даты в вузах</button>
                    <button class="filter-btn active">Мероприятия</button>
                    <button class="filter-btn">Траектория</button>
                </div>
            </div>

            <div class="filter-section">
                <div class="filter-title">Фильтровать:</div>
                <div class="filter-buttons">
                    <button class="filter-btn">Категория событий</button>
                    <button class="filter-btn">Форма проведения</button>
                    <button class="filter-btn">Направление</button>
                    <button class="filter-btn">Уровень образования</button>
                </div>
            </div>
        </div>

        <div class="events-section">
            <h2 class="section-title">ВСЕ МЕРОПРИЯТИЯ ДЛЯ АБИТУРИЕНТОВ</h2>

            <div class="event-card online">
                <div class="event-header">
                    <div class="event-info">
                        <div class="event-avatar">РГГУ</div>
                        <div class="event-details">
                            <h3>День открытых дверей в РГГУ</h3>
                            <div class="event-university">в РГГУ им. С.Г Строганова</div>
                            <div class="event-datetime">27 мая 2025 в 13:00 онлайн</div>
                        </div>
                    </div>
                    <div class="event-actions">
                        <button class="btn btn-secondary">Записаться</button>
                        <a href="#" class="remind-btn">Напомнить</a>
                    </div>
                </div>
                <div class="event-format format-online">Онлайн</div>
            </div>

            <div class="event-card offline">
                <div class="event-header">
                    <div class="event-info">
                        <div class="event-avatar">РГГУ</div>
                        <div class="event-details">
                            <h3>День открытых дверей</h3>
                            <div class="event-university">в РГГУ им. С.Г Строганова</div>
                            <div class="event-datetime">27 мая 2025 в 13:00 по адресу Волоколамское ш., 9, стр. 1, Москва</div>
                        </div>
                    </div>
                    <div class="event-actions">
                        <button class="btn btn-secondary">Записаться</button>
                        <a href="#" class="remind-btn">Напомнить</a>
                    </div>
                </div>
                <div class="event-format format-offline">Очно</div>
            </div>

            <div class="event-card online">
                <div class="event-header">
                    <div class="event-info">
                        <div class="event-avatar">ГУАП</div>
                        <div class="event-details">
                            <h3>День открытых дверей в ГУАП</h3>
                            <div class="event-university">в ГУАП</div>
                            <div class="event-datetime">27 мая 2025 в 16:00 по адресу г. Санкт-Петербург, ул. Ленсовета, 14</div>
                        </div>
                    </div>
                    <div class="event-actions">
                        <button class="btn btn-primary">Записаться</button>
                        <a href="#" class="remind-btn">Напомнить</a>
                    </div>
                </div>
                <div class="event-format format-offline">Очно</div>
            </div>

            <div class="event-card online">
                <div class="event-header">
                    <div class="event-info">
                        <div class="event-avatar">МГТ</div>
                        <div class="event-details">
                            <h3>День открытых дверей по направлению «Управление в технических системах» в МГТУ «СТАНКИН»</h3>
                            <div class="event-university">в МГТУ "СТАНКИН"</div>
                            <div class="event-datetime">27 мая 2025 в 18:00 онлайн</div>
                        </div>
                    </div>
                    <div class="event-actions">
                        <button class="btn btn-primary">Записаться</button>
                        <a href="#" class="remind-btn">Напомнить</a>
                    </div>
                </div>
                <div class="event-format format-online">Онлайн</div>
            </div>

            <div class="event-card offline">
                <div class="event-header">
                    <div class="event-info">
                        <div class="event-avatar">ИТМО</div>
                        <div class="event-details">
                            <h3>День открытых дверей ИТМО</h3>
                            <div class="event-university">в Университете ИТМО</div>
                            <div class="event-datetime">28 мая 2025 в 14:00 по адресу Кронверкский пр., 49, Санкт-Петербург</div>
                        </div>
                    </div>
                    <div class="event-actions">
                        <button class="btn btn-primary">Записаться</button>
                        <a href="#" class="remind-btn">Напомнить</a>
                    </div>
                </div>
                <div class="event-format format-offline">Очно</div>
            </div>
        </div>
    </div>

    <script>
        // Добавляем интерактивность кнопкам
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                // Убираем активный класс у всех кнопок в группе
                const group = this.parentElement;
                group.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                // Добавляем активный класс к текущей кнопке
                this.classList.add('active');
            });
        });

        document.querySelectorAll('.month-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.month-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
            });
        });

        // Анимация при появлении карточек
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        document.querySelectorAll('.event-card').forEach(card => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(card);
        });
    </script>
</body>
</html>